data/embeddings-base.*.json
data/embeddings-base.*.f32
data/embeddings-facets.*.json
data/embeddings-facets.*.f32

# Scratch drafts
.tmp/

# Leftover Worker / eval paths from prior branches (ignore if present)
worker-assets/
worker-configuration.d.ts
eval/runs/
.wrangler/
dist-worker/
