    "cardinality-F01-F30-F32": {
      "topic": "How many Source, Reproductive-level and Gender descriptors a code may have",
      "sources": [
        {
          "source": "EFSA business rule BR25 (ICT and DCF, HIGH, rejected on submission)",
          "says": "One. EFSA's rule sheet gives apple juice with two sources (A039M#F01.A05YH$F01.A05YG) as a code this rule rejects."
        },
        {
          "source": "MTX 17.1 facet flag",
          "says": "single"
        },
        {
          "source": "FoodEx2 guidance rev 2 (2015), Table 20",
          "says": "Single"
        },
        {
          "source": "MTX 17.1 facet descriptions",
          "says": "More than one descriptor can be applied to each entry, provided they are not contradicting each other."
        }
      ],
      "verdict": "A second stated descriptor is an error (BR25). The result notes that the facet description allows several.",
      "why": "EFSA's checker rejects it, and the checker comes first. Only the description text disagrees.",
      "ours": false
    },
    "cardinality-F03-exception": {
      "topic": "The \"with solid particles\" exception to single Physical-state",
      "sources": [
        {
          "source": "MTX 17.1 F03 description",
          "says": "Only one descriptor, \"apart from the specification “with solid particles”\"."
        },
        {
          "source": "MTX 17.1 catalogue data",
          "says": "\"With solid particles/pieces\" (A06JM) is not an F03 descriptor; it is in F10 Qualitative-info."
        },
        {
          "source": "MTX 17.1 facet flag and guidance 2015 Table 20",
          "says": "single"
        }
      ],
      "verdict": "F03 is single with no exception; solid particles are coded under F10.",
      "why": "Where a term sits is catalogue data, which wins. The description refers to a placement that no longer exists.",
      "ours": false
    },
    "cardinality-F17-F18-F19": {
      "topic": "How many Extent-of-cooking, Packaging-format and Packaging-material descriptors a code may have",
      "sources": [
        {
          "source": "EFSA business rule BR25",
          "says": "Several (BR25 follows the flag, which is repeatable)."
        },
        {
          "source": "MTX 17.1 facet flag and guidance 2015 Table 20",
          "says": "repeatable"
        },
        {
          "source": "MTX 17.1 facet descriptions",
          "says": "F17: only one, apart from \"presence of burned spots-parts\" (A07ND). F18: \"only one descriptor ... can usually be added\". F19: \"only one descriptor ... may be used\"."
        }
      ],
      "verdict": "A second stated descriptor is a warning that quotes the description, not an error. A07ND doesn't count for F17.",
      "why": "EFSA's checker accepts it, so it isn't an error. The newest EFSA wording says one, so the user should know.",
      "ours": false
    },
    "cardinality-F33": {
      "topic": "How many Legislative-classes descriptors a code may have",
      "sources": [
        {
          "source": "EFSA business rule BR25",
          "says": "Several (flag is repeatable)."
        },
        {
          "source": "MTX 17.1 facet flag",
          "says": "repeatable"
        },
        {
          "source": "MTX 17.1 F33 description",
          "says": "\"Only one descriptor from this facet can be added to each entry.\" It mentions food additive classes only."
        },
        {
          "source": "FoodEx2 guidance rev 2 (2015), Table 20",
          "says": "Single for each sub-list; repeatable among sub-lists."
        },
        {
          "source": "MTX 17.1 catalogue data",
          "says": "F33 now has four sub-lists (food additives, acrylamide, microbiological criteria, veterinary drug residues)."
        }
      ],
      "verdict": "A second descriptor in the same sub-list is a warning; descriptors from different sub-lists are fine.",
      "why": "The description predates the other three sub-lists, so \"only one\" most plausibly means one per legislation, as the 2015 guidance says. This is our reading, and results label it as ours.",
      "ours": true
    },
    "definition-BR16": {
      "topic": "What makes a stated process \"less detailed than the implicit facets\"",
      "sources": [
        {
          "source": "EFSA rule sheet (2020), BR16 description and example",
          "says": "A process whose ordinal code (BR_Data.csv) is lower than the implied one's. Example: A01PS#F28.A0CQZ (candied fruits, fermentation)."
        },
        {
          "source": "EFSA TermRules.java (Catalogue Browser 1.2.15, 2024)",
          "says": "A stated descriptor that is an ancestor of an implied descriptor of the same facet, for base terms in a forbidden-process food group."
        }
      ],
      "verdict": "Follow the code. EFSA's 2020 example does not fail under it (fermentation is not above \"Preserving with sugars\").",
      "why": "What EFSA's checking tool enforces comes first.",
      "ours": false
    },
    "severity-BR16": {
      "topic": "How serious it is to state a process less detailed than the implied one",
      "sources": [
        {
          "source": "EFSA rule sheet, Catalogue Browser and ICT level",
          "says": "HIGH"
        },
        {
          "source": "EFSA rule sheet, DCF behaviour",
          "says": "LOW"
        }
      ],
      "verdict": "Error, although EFSA's message says \"discouraged\".",
      "why": "The checking tool's level comes first.",
      "ours": false
    },
    "catalogue-A03VA-scope-note": {
      "topic": "Whether Composite dishes (A03VA) is only for foods with no identifiable main category, or the parent of all recipe-based dish shelves",
      "sources": [
        {
          "source": "MTX 17.1 scope note on A03VA Composite dishes",
          "says": "The category covers dishes with more than one characterising ingredient and a recipe, where the ingredients are so diverse that no relevant main category can be identified."
        },
        {
          "source": "MTX 17.1 exposure hierarchy under A03VA",
          "says": "Children include Meat based dishes, Egg based dishes, Vegetable based dishes and the other principal-ingredient dish shelves."
        },
        {
          "source": "FoodEx2 guidance rev 2 (2015), §5.1.7 and §5.4.3",
          "says": "Use a composite base term when a recipe with different ingredients and a preparation process produces the food."
        }
      ],
      "verdict": "Classify prompts omit A03VA's scope note. The hierarchy and the guidance decide: a recipe dish belongs under Composite dishes even when a main ingredient category is clear.",
      "why": "The note contradicts the term's own children and the guidance's recipe criterion, and it sends named dishes into commodity groups.",
      "ours": true
    },
    "applicability-BR03": {
      "topic": "A source facet on a composite food, naming the plant or animal behind one ingredient",
      "sources": [
        {
          "source": "EFSA TermRules.java (Catalogue Browser 1.2.15, 2024) and warningMessages.txt",
          "says": "BR03, text level HIGH. A source facet on a composite base term (type s or c) is rejected. There is no exception. \"Choose instead an F04 ingredient facet.\""
        },
        {
          "source": "FoodEx2 guidance rev 2 (2015), §5.11 and Table 20",
          "says": "The source facet is normally never used on a composite. It may be tolerated when one characterising ingredient is a generic commodity and the exact plant or animal is known, because a facet cannot carry its own facet. Table 20 says F01 applies to composite food in rare cases, to specify a single generic source commodity."
        }
      ],
      "verdict": "Error (BR03), including that one-ingredient case. The plant or animal is recorded in text, not as F01.",
      "why": "The checking tool is the newer source, and it comes first. The 2015 exception is not in the checker.",
      "ours": false
    }
